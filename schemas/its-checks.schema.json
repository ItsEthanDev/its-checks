{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "its-checks project selections",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "bundles", "answers"],
        "properties": {
          "repository": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9_.-]+$" },
          "commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
          "bundles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "answers": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/id" },
              "additionalProperties": { "type": ["string", "number", "boolean"] }
            }
          }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
}
