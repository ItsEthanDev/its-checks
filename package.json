{
  "name": "its-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": { "its-checks": "src/cli.ts" },
  "files": ["src", "policy", "schemas"],
  "packageManager": "bun@1.4.0",
  "engines": { "bun": ">=1.4.0" },
  "scripts": {
    "test": "bun test ./test/*.test.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test:managers": "bun test --timeout=120000 --max-concurrency=1 ./test/real-managers.integration.ts",
    "test:cli": "python3 test/cli.pty.py",
    "test:package": "bun test --timeout=120000 ./test/package.integration.ts",
    "test:policy": "bun test --timeout=180000 --max-concurrency=1 ./test/policy-compatibility.integration.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@yarnpkg/lockfile": "1.1.0",
    "effect": "4.1.1",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/yarnpkg__lockfile": "1.1.9",
    "typescript": "6.0.2",
    "yarn": "1.22.22"
  }
}
