{
  "name": "its-checks",
  "version": "0.1.0-beta.3",
  "private": true,
  "bin": {
    "its-checks": "bin/its-checks.js"
  },
  "files": [
    "bin",
    "src",
    "policy",
    "schemas"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test ./test/*.test.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test:managers": "bun test --timeout=120000 --max-concurrency=1 ./test/real-managers.integration.ts",
    "test:cli": "python3 test/cli.pty.py",
    "test:package": "bun test --timeout=120000 ./test/package.integration.ts",
    "test:policy": "bun test --timeout=180000 --max-concurrency=1 ./test/policy-compatibility.integration.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "effect": "4.1.1",
    "jsonc-parser": "3.3.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.2",
    "yarn": "1.22.22"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0"
}
