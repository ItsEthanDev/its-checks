{
  "name": "Next.js",
  "description": "Framework correctness, images, links, scripts, and generated-output exclusions; select React for component rules",
  "requires": ["typescript"],
  "files": [
    {
      "source": "files/.oxfmtrc.json",
      "target": ".oxfmtrc.json",
      "operation": "compose",
      "format": "json",
      "arrays": {
        "/ignorePatterns": "append-unique"
      }
    },
    {
      "source": "files/.oxlintrc.json",
      "target": ".oxlintrc.json",
      "operation": "compose",
      "format": "json",
      "arrays": {
        "/plugins": "append-unique",
        "/ignorePatterns": "append-unique"
      }
    }
  ]
}
