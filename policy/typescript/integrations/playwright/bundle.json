{
  "name": "Playwright",
  "description": "Awaited browser operations, web-first assertions, reliable waits, and focused-test prevention",
  "devDependencies": {
    "eslint-plugin-playwright": "2.12.2"
  },
  "inputs": [
    {
      "id": "test-files",
      "prompt": "Playwright test-file glob (exclude unit tests)",
      "type": "string",
      "default": "tests/**",
      "destination": {
        "file": ".oxlintrc.json",
        "field": ["overrides", 0, "files", 0]
      }
    }
  ]
}
