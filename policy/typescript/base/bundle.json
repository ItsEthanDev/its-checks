{
  "name": "TypeScript",
  "description": "Opinionated formatting and type-aware linting",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "check": "node --run fmt:check && node --run lint"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "migration": {
    "removeFiles": [
      ".prettierrc",
      ".prettierrc.json",
      "prettier.config.js",
      "prettier.config.mjs",
      ".eslintrc.json",
      "eslint.config.js",
      "eslint.config.mjs",
      "biome.json"
    ],
    "removeDevDependencies": ["prettier", "biome", "@biomejs/biome", "eslint"]
  }
}
