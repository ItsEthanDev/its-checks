{
  "name": "Dependency Cruiser",
  "description": "Public module entry points, public-interface tests, and dependency hygiene",
  "note": "**MIGRATION NOTE**\n\nTo adopt deep modules, ask your agent:\n\n\"Read src/modules/README.md. If it contains a migration TODO, work through it.\"",
  "devDependencies": {
    "dependency-cruiser": "18.7.2"
  },
  "scripts": {
    "lint": "depcruise .",
    "lint:fix": "depcruise ."
  },
  "requires": ["typescript"],
  "files": [
    {
      "source": "files/modules.README.md",
      "target": "src/modules/README.md",
      "operation": "seed"
    },
    {
      "source": "files/.dependency-cruiser.json",
      "target": ".dependency-cruiser.json",
      "operation": "replace",
      "format": "json"
    },
    {
      "source": "files/.oxlintrc.json",
      "target": ".oxlintrc.json",
      "operation": "compose",
      "format": "json",
      "fields": {
        "/rules/import~1no-cycle": { "replaces": "typescript" }
      }
    }
  ]
}
