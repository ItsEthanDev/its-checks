{
  "name": "Testing Library",
  "description": "Awaited queries and interactions, accessible DOM queries, and side-effect-free retries",
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-testing-library": "7.16.2"
  },
  "requires": ["typescript"],
  "files": [
    {
      "source": "files/.oxlintrc.json",
      "target": ".oxlintrc.json",
      "operation": "compose",
      "format": "json",
      "fields": {
        "/jsPlugins": { "merge": "append-unique" },
        "/overrides": { "merge": "append-unique" }
      }
    }
  ]
}
