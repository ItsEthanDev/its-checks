{
  "name": "TanStack Query",
  "description": "Cache dependencies, stable query clients, tracked results, and inference-safe query options",
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5.105.3"
  },
  "requires": ["typescript"],
  "files": [
    {
      "source": "files/.oxlintrc.json",
      "target": ".oxlintrc.json",
      "operation": "compose",
      "format": "json",
      "fields": {
        "/jsPlugins": { "merge": "append-unique" }
      }
    }
  ]
}
