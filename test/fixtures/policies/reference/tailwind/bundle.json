{
  "name": "Tailwind CSS v4",
  "description": "Test-owned class sorting and lint compatibility reference",
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "eslint-plugin-tailwindcss": "4.4.0"
  },
  "inputs": [
    {
      "id": "formatter-stylesheet",
      "prompt": "Tailwind v4 stylesheet path (Oxfmt)?",
      "type": "path",
      "default": "src/styles.css",
      "destination": {
        "file": ".oxfmtrc.json",
        "field": ["sortTailwindcss", "stylesheet"]
      }
    },
    {
      "id": "linter-stylesheet",
      "prompt": "Same Tailwind v4 stylesheet path (lint plugin)?",
      "type": "path",
      "default": "src/styles.css",
      "destination": {
        "file": ".oxlintrc.json",
        "field": ["settings", "tailwindcss", "cssConfigPath"]
      }
    }
  ],
  "requires": ["base"],
  "files": [
    {
      "source": "files/.oxfmtrc.json",
      "target": ".oxfmtrc.json",
      "operation": "compose",
      "format": "json",
      "arrays": {
        "/ignorePatterns": "append-unique"
      }
    },
    {
      "source": "files/.oxlintrc.json",
      "target": ".oxlintrc.json",
      "operation": "compose",
      "format": "json",
      "arrays": {
        "/plugins": "append-unique",
        "/jsPlugins": "append-unique",
        "/extends": "append-unique",
        "/overrides": "append-unique",
        "/ignorePatterns": "append-unique"
      }
    }
  ]
}
